{
  "_meta": {
    "schema_version": "1.0",
    "description": "MA-ZEN auth schema. Migration path → PostgreSQL: users, sessions, devices, verification_tokens tables.",
    "tables_mapped_to": ["users", "sessions", "devices", "verification_tokens", "password_resets"]
  },
  "schema": {
    "user": {
      "id":                "uuid",
      "email":             "string (unique)",
      "email_verified":    "boolean",
      "password_hash":     "string (bcrypt, never stored in localStorage — placeholder only)",
      "oauth_provider":    "google | apple | null",
      "oauth_id":          "string | null",
      "display_name":      "string | null",
      "avatar_url":        "string | null",
      "created_at":        "ISO8601",
      "last_seen_at":      "ISO8601",
      "status":            "active | suspended | deleted"
    },
    "session": {
      "id":             "uuid",
      "user_id":        "uuid",
      "token":          "string (JWT or opaque, stored in localStorage as session_token)",
      "device_id":      "uuid",
      "created_at":     "ISO8601",
      "expires_at":     "ISO8601",
      "revoked":        "boolean",
      "revoked_at":     "ISO8601 | null"
    },
    "device": {
      "id":           "uuid",
      "user_id":      "uuid",
      "session_id":   "uuid",
      "name":         "string (browser+OS fingerprint)",
      "user_agent":   "string",
      "ip_last":      "string",
      "last_seen_at": "ISO8601",
      "is_current":   "boolean"
    },
    "verification_token": {
      "id":         "uuid",
      "user_id":    "uuid",
      "type":       "email_verify | password_reset",
      "token":      "string (6-digit code for email, UUID for link)",
      "expires_at": "ISO8601",
      "used":       "boolean"
    }
  },
  "local_storage_keys": {
    "session_token":  "mazen_session_token",
    "user_profile":   "mazen_user_profile",
    "device_id":      "mazen_device_id",
    "devices":        "mazen_devices"
  },
  "oauth_providers": {
    "google": {
      "client_id":    "REPLACE_WITH_GOOGLE_CLIENT_ID",
      "scope":        "openid email profile",
      "redirect_uri": "https://dunkin2025.github.io/mazen/auth/callback.html"
    },
    "apple": {
      "client_id":    "REPLACE_WITH_APPLE_SERVICE_ID",
      "scope":        "openid email name",
      "redirect_uri": "https://dunkin2025.github.io/mazen/auth/callback.html"
    }
  },
  "session_config": {
    "token_ttl_days":      30,
    "refresh_threshold_days": 7,
    "max_devices":         10,
    "require_verification": true
  },
  "password_rules": {
    "min_length":  8,
    "require_uppercase": false,
    "require_number":    true,
    "require_symbol":    false,
    "strength_labels":   ["WEAK", "FAIR", "STRONG"]
  },
  "mock_users": [
    {
      "id":             "demo-user-001",
      "email":          "demo@ma-zen.io",
      "email_verified": true,
      "display_name":   "Demo User",
      "oauth_provider": null,
      "created_at":     "2025-01-01T00:00:00Z",
      "status":         "active"
    }
  ]
}
